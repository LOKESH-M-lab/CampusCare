# CampusCare - Server Configuration
PORT=5000

# MongoDB Connection String
# Local MongoDB (Default for local development)
MONGODB_URI=mongodb://127.0.0.1:27017/campuscare

# MongoDB Atlas (Cloud) Alternative Example:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xyz.mongodb.net/campuscare?retryWrites=true&w=majority

# Client Origin (CORS Configuration)
# Set to * to allow all origins or specify your frontend URL
CLIENT_ORIGIN=*
